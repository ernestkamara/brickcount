# Copy to .env.local (git-ignored) and fill in to enable the optional cloud double-check.
# These are Firebase *web* config values: public identifiers that ship in the app bundle,
# not secrets. The Anthropic API key lives only in Firebase Secret Manager
# (firebase functions:secrets:set ANTHROPIC_API_KEY) and must never go here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
